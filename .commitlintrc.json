{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [
      2,
      "always",
      [
        "@app/web",
        "@promptshield/cli",
        "@promptshield/core",
        "@promptshield/ignore",
        "@promptshield/lsp",
        "@promptshield/sanitizer",
        "@promptshield/tiptap",
        "@promptshield/workspace",
        "@tool/scripts",
        "@tool/tsconfig",
        "promptshield"
      ]
    ]
  }
}

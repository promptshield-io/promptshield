{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base Standards */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],

    /* Module Resolution */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    /* Path Mapping */
    "paths": {
      "@promptshield/cli": ["./packages/cli/src", "./packages/cli/dist"],
      "@promptshield/core": ["./packages/core/src", "./packages/core/dist"],
      "@promptshield/ignore": [
        "./packages/ignore/src",
        "./packages/ignore/dist"
      ],
      "@promptshield/lsp": ["./packages/lsp/src", "./packages/lsp/dist"],
      "@promptshield/sanitizer": [
        "./packages/sanitizer/src",
        "./packages/sanitizer/dist"
      ],
      "@promptshield/tiptap": [
        "./packages/tiptap/src",
        "./packages/tiptap/dist"
      ],
      "@promptshield/workspace": [
        "./packages/workspace/src",
        "./packages/workspace/dist"
      ],
      "promptshield": ["./packages/vscode/src", "./packages/vscode/dist"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "vitest.config.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.turbo",
    "apps",
    "examples",
    "coverage"
  ]
}
